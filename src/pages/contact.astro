---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import {services,url} from '../data/content';
---
<Layout title="Start Your Project & Request an Estimate" description="Discuss your San Jose remodeling project. Call (408) 679-8566 or prepare a detailed email inquiry for Ocean General Contractors."><section class="section contact-page"><div class="contact-copy"><p class="eyebrow">LET’S MAKE ROOM FOR WHAT’S NEXT</p><h1>It starts with<br/><em>a conversation.</em></h1><p>Tell us a little about your home and what you have in mind. We’ll take it from there.</p><div class="contact-details"><div><span class="eyebrow">GIVE US A CALL</span><a href="tel:+14086798566">(408) 679-8566 <Arrow diagonal/></a></div><div><span class="eyebrow">DROP US A NOTE</span><a href="mailto:bluecollarcorgis@gmail.com">bluecollarcorgis@gmail.com <Arrow diagonal/></a></div><div><span class="eyebrow">BASED IN</span><p>San Jose, CA 95116</p><a class="small-link" href={url('/service-areas/')}>Explore our service areas →</a></div><div><span class="eyebrow">OFFICE HOURS</span><p>Mon–Fri: 7:00 am–7:00 pm<br/>Saturday: 8:00 am–5:00 pm<br/>Sunday: 9:30 am–3:00 pm</p></div></div></div><div class="contact-form-wrap"><p class="eyebrow">YOUR PROJECT, IN A FEW WORDS</p><h2>Let’s begin.</h2><p class="form-notice">This demo prepares an email draft. It does not submit your information. Review and send the draft from your email app, or call us directly.</p><form id="estimate-form" novalidate><div class="form-grid"><div class="field"><label for="full-name">Full name <span>*</span></label><input id="full-name" name="name" autocomplete="name" required maxlength="100" placeholder="Your name" aria-describedby="name-error"/><span class="field-error" id="name-error"></span></div><div class="field"><label for="email">Email address <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="160" placeholder="you@example.com" aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div><div class="field"><label for="phone">Phone number <span>*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="(408) 555-0123" aria-describedby="phone-error"/><span class="field-error" id="phone-error"></span></div><div class="field"><label for="service">Type of project <span>*</span></label><select id="service" name="service" required aria-describedby="service-error"><option value="">Select a service</option>{services.map(s=><option value={s.slug}>{s.name}</option>)}<option value="not-sure">Not sure yet</option></select><span class="field-error" id="service-error"></span></div><div class="field"><label for="location">Project location <span>*</span></label><input id="location" name="location" autocomplete="address-level2" required maxlength="150" placeholder="City or ZIP code" aria-describedby="location-error"/><span class="field-error" id="location-error"></span></div><div class="field"><label for="preferred">Preferred contact method</label><select id="preferred" name="preferred"><option>Email</option><option>Phone</option></select></div><div class="field full"><label for="description">What do you have in mind? <span>*</span></label><textarea id="description" name="description" rows="4" required minlength="20" maxlength="3000" placeholder="Tell us about your space, your ideas, and any timing you have in mind…" aria-describedby="description-error"></textarea><span class="field-error" id="description-error"></span></div></div><div class="honeypot" aria-hidden="true"><label for="website">Leave this field blank</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div><p class="fine-print">* Required fields. Details stay in this browser until you choose to send an email. <a href={url('/privacy/')}>Privacy information</a>.</p><button class="button dark form-submit" type="submit">Prepare my inquiry <Arrow diagonal/></button><p id="form-status" class="form-status" role="status" tabindex="-1"></p><div id="email-draft" hidden><h3>Your inquiry is ready to review.</h3><textarea id="draft-text" aria-label="Prepared inquiry" rows="8" readonly></textarea><div class="draft-actions"><a id="send-email" class="button dark" href="mailto:bluecollarcorgis@gmail.com">Open email draft <Arrow diagonal/></a><button class="text-link" type="button" id="copy-draft">Copy details</button></div><p class="fine-print">Nothing has been sent. If an email app does not open, copy the details and email bluecollarcorgis@gmail.com.</p></div><noscript><p>Please call <a href="tel:+14086798566">(408) 679-8566</a> or <a href="mailto:bluecollarcorgis@gmail.com">email us directly</a>. The draft builder requires JavaScript.</p></noscript></form></div></section></Layout>

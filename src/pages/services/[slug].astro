---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import CTA from '../../components/CTA.astro';
import {services,url} from '../../data/content';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
---
<Layout title={`${service.name} in San Jose`} description={`${service.description} Discuss your ${service.short.toLowerCase()} project in San Jose with Ocean General Contractors.`}><section class="service-hero"><div class="service-hero-copy"><a class="eyebrow breadcrumb" href={url('/services/')}>← ALL SERVICES</a><span class="service-detail-number">{service.number} /</span><h1>{service.name}</h1><p>{service.tagline}</p><a class="button dark" href={url(`/contact/?service=${service.slug}`)}>Discuss your project <Arrow diagonal/></a></div><div class="service-hero-photo"><Photo name={service.image} alt={`${service.short} design inspiration`} eager/><span class="image-note">Design inspiration</span></div></section><section class="section service-overview"><div><p class="eyebrow">A CONSIDERED APPROACH</p><h2>Designed around<br/><em>the way you live.</em></h2></div><div><p class="large-copy">{service.intro}</p><p>Share your ideas, your priorities, and your project location. We’ll discuss the possibilities and the next steps toward an estimate tailored to your home.</p></div></section><section class="section scope-section"><p class="eyebrow">THE DETAILS THAT MATTER</p><div class="scope-list">{service.details.map((detail,i)=><div><span>0{i+1}</span><h3>{detail}</h3><Arrow diagonal/></div>)}</div></section><section class="section faq-section"><h2>A little clarity.<br/><em>Before we begin.</em></h2><div>{service.questions.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}<details><summary>How do I request an estimate?<span aria-hidden="true">+</span></summary><p>Call <a href="tel:+14086798566">(408) 679-8566</a> or use our <a href={url('/contact/')}>project inquiry page</a> to prepare an email with your project details.</p></details></div></section><section class="section related-services"><p class="eyebrow">MORE POSSIBILITIES</p><div>{services.filter(s=>s.slug!==service.slug).slice(0,3).map(s=><a href={url(`/services/${s.slug}/`)}>{s.short}<Arrow diagonal/></a>)}</div></section><CTA/></Layout>

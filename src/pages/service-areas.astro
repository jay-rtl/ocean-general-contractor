---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import CTA from '../components/CTA.astro';
import {areas,url} from '../data/content';
---
<Layout title="Serving San Jose & Nearby Communities" description="Ocean General Contractors serves San Jose, Campbell, Los Gatos, Santa Clara County, and Fremont with remodeling, painting, and flooring services."><section class="page-intro section"><p class="eyebrow">CLOSE TO HOME</p><h1>Rooted here.<br/><em>Ready for your next chapter.</em></h1></section><section class="section areas-layout"><div class="area-art"><svg viewBox="0 0 500 520" role="img" aria-label="Schematic of service communities around San Jose; not a geographic map"><g class="map-lines" fill="none" stroke="currentColor"><path d="M30 70 180 120 230 220 340 350 470 430M10 310 140 285 230 220 350 160 460 50M80 500 155 385 230 220 250 100 280 0M0 400 155 385 340 350 500 285M30 70 100 185 140 285 100 415M100 185 240 145 350 160 460 260M180 120 310 60 460 50M155 385 300 460 470 430"/><circle cx="230" cy="220" r="130" stroke-dasharray="4 7"/><circle cx="230" cy="220" r="185" stroke-dasharray="2 9"/></g><g fill="currentColor"><circle cx="230" cy="220" r="6"/><circle cx="155" cy="290" r="4"/><circle cx="155" cy="385" r="4"/><circle cx="350" cy="160" r="4"/></g><g class="map-text" fill="currentColor"><text x="248" y="225">SAN JOSE</text><text x="170" y="295">CAMPBELL</text><text x="170" y="390">LOS GATOS</text><text x="367" y="165">FREMONT</text><text x="40" y="470">SANTA CLARA COUNTY</text></g></svg><p class="eyebrow">OUR COMMUNITY · SCHEMATIC ONLY</p></div><div><p class="large-copy">Thoughtful remodeling for the communities we call home.</p><p>Based in San Jose, we work with homeowners in the following published service areas. Share your project address to confirm availability for your location.</p><div class="area-list">{areas.map((area,i)=><a href={url(`/contact/?location=${encodeURIComponent(area)}`)}><span>0{i+1}</span><h2>{area}</h2><Arrow diagonal/></a>)}</div></div></section><CTA/></Layout>

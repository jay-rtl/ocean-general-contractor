---
import {reviews,url} from '../data/content';
import Arrow from './Arrow.astro';
---
<section class="testimonials section" aria-label="Customer review excerpts"><div><p class="eyebrow">IN THEIR WORDS</p><h2>Good work.<br/><em>Lasting impressions.</em></h2><a class="text-link" href={url('/reviews/')}>More client experiences <Arrow /></a></div><div class="review-carousel" aria-roledescription="carousel" aria-label="Customer reviews"><span class="quote-mark" aria-hidden="true">“</span><div class="review-slides" aria-live="polite">{reviews.map((review,i)=><figure class="review-slide" hidden={i!==0}><blockquote>“{review.quote}”</blockquote><figcaption><strong>{review.name}</strong><span>{review.topic}</span></figcaption></figure>)}</div><div class="review-controls"><span class="review-count">01 / 03</span><button type="button" class="circle-button" data-review-prev aria-label="Previous review"><span class="reverse"><Arrow /></span></button><button type="button" class="circle-button" data-review-next aria-label="Next review"><Arrow /></button></div><p class="fine-print">Excerpts from reviews published on the company website.</p></div></section>
